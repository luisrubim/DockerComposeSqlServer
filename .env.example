# Copie este arquivo para .env e ajuste os valores:  cp .env.example .env
# O .env não é versionado (está no .gitignore).

# Senha do usuário sa. Escolha a sua.
# Requisitos do SQL Server: mínimo 8 caracteres e 3 destes 4 grupos:
# maiúsculas, minúsculas, números e símbolos. Senha fraca impede o container de subir.
MSSQL_SA_PASSWORD=Troque_Esta_Senha1

# Nome do banco. O restore procura ./backup/<DB_NAME>.bak
DB_NAME=MeuBanco

MSSQL_COLLATION=SQL_Latin1_General_CP1_CI_AS

# Opcionais (veja "Acesso ao banco" no README)
# SQL_BIND=127.0.0.1
# SQL_PORT=1433
